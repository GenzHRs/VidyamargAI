# Copy to .env. Generate separate random values; never reuse uploaded credentials.
SECRET_KEY=
POSTGRES_PASSWORD=
# Local Python process: use your PostgreSQL host and URL-encoded password.
DATABASE_URL=postgresql://vidyamarg:CHANGE_ME@localhost:5432/vidyamarg
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_STORAGE_URI=memory://
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
STORAGE_DIR=storage
SCHEDULER_ENABLED=false
# Empty disables public administrator signup and HR machine writes respectively.
ADMIN_REGISTRATION_KEY=
HR_SYNC_SECRET=
GEMINI_API_KEY=
NVIDIA_API_KEY=
NVIDIA_API_KEY_FALLBACK=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
SERPER_API_KEY=
APIFY_API_TOKEN=
QDRANT_URL=
QDRANT_API_KEY=
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_SESSION_STRING=
TG_SESSION_FILE=
# Optional MinIO. Create a private bucket before enabling; errors do not silently switch storage.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=true
MINIO_BUCKET=hireai
MINIO_REGION=us-east-1
RESEND_API_KEY=
SENDGRID_API_KEY=
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Environment & Testing Auth Bypass (Strictly disabled by default)
# Local testing or explicitly authorized staging deployment. Fails closed in production.
ENVIRONMENT=development
DEV_AUTH_BYPASS=false
DEV_AUTH_BYPASS_DEPLOYMENT=

# Compose build arguments. For local npm development, copy these to frontend/.env.local.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_HR_AGENT_API_URL=
NEXT_PUBLIC_DEV_AUTH_BYPASS=false
NEXT_PUBLIC_DEV_AUTH_BYPASS_DEPLOYMENT=

